<!DOCTYPE html>
<html lang="nl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Dylan Tallane – Marketing- en brandingprofessional</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700&family=Figtree:wght@400;600&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#FFFFFF; --ink:#1E2148; --mute:#5E6280; --line:#ECE8E4;
  --a:#F7773A; --at:#C9490F; color-scheme:light;
  --display:"Bricolage Grotesque","Helvetica Neue",Arial,sans-serif;
  --body:"Figtree","Helvetica Neue",Arial,sans-serif;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
[data-lens="merk"]{--a:#F7773A;--at:#C9490F}
[data-lens="klant"]{--a:#E0337A;--at:#CF2870}
[data-lens="commercie"]{--a:#0FA597;--at:#0B7F76}
[data-lens="creatie"]{--a:#3B4EF2;--at:#3B4EF2}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--body);font-size:1.0625rem;line-height:1.65}
.wrap{max-width:56rem;margin:0 auto;padding:0 1.5rem}
a{color:inherit;text-decoration-color:var(--a);text-underline-offset:.25em;text-decoration-thickness:2px}
a:hover{color:var(--at)}
:focus-visible{outline:3px solid var(--a);outline-offset:3px;border-radius:4px}

/* Hero: een tint-vlak met een cirkel als 'bril' */
.hero{position:relative;overflow:hidden;margin-top:1.5rem;border-radius:1.75rem;display:grid;grid-template-columns:minmax(0,1fr) minmax(14rem,25rem);align-items:end;
  background:color-mix(in srgb,var(--a) 15%,var(--bg));transition:background .4s}
.hero-text{position:relative;z-index:2;padding:clamp(2rem,7vw,4.5rem) 0 clamp(2rem,6vw,4rem) clamp(2rem,7vw,4.5rem)}
.portrait{position:relative;z-index:1;align-self:end;margin-right:clamp(1rem,4vw,3rem)}
.portrait::before{content:"";position:absolute;left:-3%;width:106%;top:13%;aspect-ratio:1;border-radius:50%;background:var(--a);transition:background .4s}
.portrait img{position:relative;display:block;width:100%;height:auto}
h1{font-family:var(--display);font-weight:700;font-size:clamp(2.75rem,9vw,5.5rem);line-height:.98;letter-spacing:-.04em;margin:0;max-width:9ch}
.role{font-family:var(--display);font-weight:500;font-size:clamp(1.15rem,2.6vw,1.5rem);margin:1.25rem 0 0}
.intro{max-width:38ch;margin:.9rem 0 0;color:var(--mute)}
.actions{display:flex;flex-wrap:wrap;gap:.6rem;margin-top:1.5rem}
.btn{font:inherit;font-weight:600;font-size:.97rem;display:inline-flex;align-items:center;gap:.5rem;padding:.6rem 1.25rem;border-radius:999px;border:1.5px solid var(--at);background:var(--at);color:#fff;text-decoration:none;cursor:pointer;transition:background .2s,color .2s}
.btn:hover{background:transparent;color:var(--at)}
.btn.alt{background:transparent;color:var(--at)}
.btn.alt:hover{background:var(--at);color:#fff}
.btn[hidden]{display:none}
.lens{margin-top:clamp(2rem,5vw,3rem)}
.chips{display:flex;flex-wrap:wrap;gap:.4rem}
.chip{font:inherit;font-weight:600;font-size:.95rem;color:var(--ink);background:var(--bg);border:1.5px solid transparent;border-radius:999px;padding:.4rem .95rem;cursor:pointer;transition:background .2s,color .2s}
.chip:hover{border-color:var(--a)}
.chip[aria-pressed="true"]{background:var(--at);color:#fff}
.lens p{font-family:var(--display);font-weight:500;font-size:clamp(1.3rem,3.2vw,1.9rem);line-height:1.25;letter-spacing:-.01em;max-width:22ch;margin:1.25rem 0 0;min-height:3.8em}

section{padding:clamp(2.5rem,6vw,4rem) 0}
section+section{border-top:1px solid var(--line)}
h2{font-family:var(--display);font-weight:700;font-size:1.5rem;letter-spacing:-.02em;margin:0 0 1.75rem}
.job{display:grid;grid-template-columns:8rem 1fr;gap:.25rem 2rem;padding:1.4rem 0;border-top:1px solid var(--line)}
.job:first-of-type{border-top:0;padding-top:0}
.years{font-family:var(--display);font-weight:700;color:var(--at);font-variant-numeric:tabular-nums;transition:color .4s}
h3{font-family:var(--display);font-weight:700;font-size:1.2rem;line-height:1.25;letter-spacing:-.01em;margin:0}
.org{font-weight:600;margin:.15rem 0 0}
.job p{color:var(--mute);margin:.6rem 0 0;max-width:58ch}
.brands{color:var(--ink)!important}
.note{font-size:.9rem}
.two{display:grid;grid-template-columns:1fr 1fr;gap:3rem}
.two p{margin:0 0 1rem}
.two small{display:block;color:var(--mute);font-size:inherit}
.skills{list-style:none;padding:0;margin:0;display:flex;flex-wrap:wrap;gap:.5rem}
.skills li{border-radius:999px;padding:.3rem .95rem;font-size:.97rem;background:color-mix(in srgb,var(--a) 17%,var(--bg));transition:background .4s}

.contact-card{border-radius:1.75rem;padding:clamp(1.75rem,5vw,3rem);background:color-mix(in srgb,var(--a) 15%,var(--bg));transition:background .4s}
.facts{display:grid;grid-template-columns:7rem 1fr;gap:.45rem 1.5rem;margin:0}
.facts dt{color:var(--mute)}
.facts dd{margin:0;font-weight:600}
.contact{padding-bottom:clamp(3rem,8vw,5rem)}
.goals{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
.goal{display:flex;align-items:center;gap:1rem;padding:1.4rem 1.5rem;border-radius:1.25rem;background:color-mix(in srgb,var(--a) 15%,var(--bg));font-family:var(--display);font-weight:700;font-size:1.2rem;line-height:1.25;letter-spacing:-.01em;transition:background .4s}
.goal::before{content:"";flex:none;width:2.25rem;aspect-ratio:1;border-radius:50%;background:var(--a);transition:background .4s}
@media (max-width:640px){.goals{grid-template-columns:1fr}}

@media (max-width:760px){.hero{grid-template-columns:1fr}.hero-text{padding:2rem 1.5rem 1.5rem}.portrait{width:min(17rem,78%);margin:0 auto}}
@media (max-width:640px){.job,.facts{grid-template-columns:1fr}.facts dd{margin-bottom:.6rem}.two{grid-template-columns:1fr;gap:2rem}h1{max-width:100%}}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>
<main class="wrap">

<header class="hero">
<div class="hero-text">
  <h1>Dylan Tallane</h1>
  <p class="role">Marketing- en brandingprofessional</p>
  <p class="intro">Mijn nieuwsgierigheid maakt dat ik vraagstukken altijd vanuit verschillende perspectieven bekijk. Ik werk pragmatisch en probleemoplossend, met oog voor wat werkt.</p>

  <div class="actions">
    <a class="btn" href="https://www.linkedin.com/in/dretallane" target="_blank" rel="noopener">LinkedIn</a>
    <button class="btn alt" id="dl" type="button" hidden>Download cv (pdf)</button>
  </div>

  <div class="lens">
    <div class="chips" role="group" aria-label="Kies een perspectief">
      <button class="chip" data-k="merk" aria-pressed="true">Merk</button>
      <button class="chip" data-k="klant" aria-pressed="false">Klant</button>
      <button class="chip" data-k="commercie" aria-pressed="false">Commercie</button>
      <button class="chip" data-k="creatie" aria-pressed="false">Creatie</button>
    </div>
    <p id="lens-text" aria-live="polite">Waar staat het merk voor en hoe positioneer je het in de markt?</p>
  </div>
</div>
  <div class="portrait"><img alt="Portret van Dylan Tallane" width="640" height="807" src="data:image/webp;base64,"></div>
</header>

<section>
  <h2>Ervaring</h2>

  <article class="job">
    <div class="years">2026 – nu</div>
    <div>
      <h3>Senior Marketing Communicatie specialist</h3>
      <div class="org">REAL Concepts</div>
      <p>Verantwoordelijk voor het vertalen van strategische keuzes naar marketing- en communicatieplannen.</p>
    </div>
  </article>

  <article class="job">
    <div class="years">2023 – 2025</div>
    <div>
      <h3>Strategy consultant</h3>
      <div class="org">Disxt, digital creative agency</div>
      <p>Als Client Lead verantwoordelijk voor eigen klanten, met focus op strategie en creatieve richting voor de positionering van merken. Directe adviseur voor klanten bij business-, merk- en creatieve vraagstukken. Intensief betrokken bij pitches en bij de herpositionering van Disxt zelf.</p>
      <p class="brands">MediaMarkt, DPG Media NL &amp; BE, Centraal Beheer, Ziggo, hollandsnieuwe, Perrigo en CCV</p>
      <p class="note">Disxt ging failliet in september 2025.</p>
    </div>
  </article>

  <article class="job">
    <div class="years">2022 – 2023</div>
    <div>
      <h3>Brandmanager</h3>
      <div class="org">Intersnack Nederland</div>
      <p>Overall brandmanager voor Chio, POM-BAR en Tyrells. Uitvoering van internationale merkstrategieën in afstemming met het moederbedrijf, campagnes voor retail en media, en samenwerking met Trade en Sales. Resultaten monitoren en optimaliseren, met onderzoek naar productportfolio, markttrends en consumentengedrag.</p>
    </div>
  </article>

  <article class="job">
    <div class="years">2019 – 2022</div>
    <div>
      <h3>Strategy consultant, campaign strategist en digital consultant</h3>
      <div class="org">Disxt, digital creative agency</div>
      <p>Meegegroeid van productiebedrijf naar creative agency en van operationeel werk naar het strategieteam. Werksessies met klanten, analyses van markt, klantgedrag en concurrentie, vertaald naar jaarplannen, campagnetactieken en omnichannel creatives.</p>
      <p class="brands">DPG Media NL &amp; BE, HEMA, Centraal Beheer, Allianz Direct, Qmusic, Univé, OHRA en CCV</p>
    </div>
  </article>

  <article class="job">
    <div class="years">2017 – 2019</div>
    <div>
      <h3>Digital mediaplanner</h3>
      <div class="org">Mediabureau ZIGT</div>
      <p>Spil tussen research, strategen en specialisten, en sparringpartner voor klanten. Mediaplannen, inkoop, onderhandeling en bijsturing op resultaten.</p>
      <p class="brands">Lidl, Riedel, Sixt en Politie</p>
    </div>
  </article>

  <article class="job">
    <div class="years">2015 – 2016</div>
    <div>
      <h3>Marketeer</h3>
      <div class="org">BDO Nederland</div>
      <p>Marketing voor leadgeneratie in Amsterdam en Haarlem: evenementen, content, sponsoring en PR.</p>
    </div>
  </article>
</section>

<section>
  <div class="two">
    <div>
      <h2>Opleiding</h2>
      <p>Commerciële economie (SPECO)<small>Fontys, 2011 – 2015</small></p>
      <p>Business sport &amp; events, minor<small>HvA, 2013</small></p>
    </div>
    <div>
      <h2>Skills</h2>
      <ul class="skills">
        <li>Nieuwsgierig</li><li>Branding &amp; positionering</li><li>Klant- en consumentgericht</li><li>Pragmatisch</li><li>Probleemoplossend</li><li>Samenwerking</li>
      </ul>
    </div>
  </div>
</section>

<section>
  <h2>Leerdoelen</h2>
  <div class="goals">
    <div class="goal">Branding in het AI-tijdperk</div>
    <div class="goal">Ontwikkeling in consumentenpsychologie</div>
  </div>
</section>

<section class="contact">
  <div class="contact-card">
    <h2>Contact</h2>
    <dl class="facts">
      <dt>E-mail</dt><dd><a href="mailto:dylantallane@gmail.com">dylantallane@gmail.com</a></dd>
      <dt>Telefoon</dt><dd><a href="tel:+31625317264">06-25317264</a></dd>
      <dt>LinkedIn</dt><dd><a href="https://www.linkedin.com/in/dretallane">linkedin.com/in/dretallane</a></dd>
      <dt>Geboren</dt><dd>13 januari 1992</dd>
    </dl>
  </div>
</section>

</main>
<script>
(function(){
  var t={
    merk:"Waar staat het merk voor en hoe positioneer je het in de markt?",
    klant:"Wie is de klant of consument, en wat beweegt die?",
    commercie:"Wat levert het op? Monitoren, bijsturen en optimaliseren.",
    creatie:"Hoe wordt een strategische keuze een idee dat werkt in elk kanaal?"
  };
  var root=document.documentElement, out=document.getElementById("lens-text");
  root.setAttribute("data-lens","merk");
  document.querySelectorAll(".chip").forEach(function(b){
    b.addEventListener("click",function(){
      var k=b.getAttribute("data-k");
      root.setAttribute("data-lens",k);
      out.textContent=t[k];
      document.querySelectorAll(".chip").forEach(function(c){c.setAttribute("aria-pressed",c===b?"true":"false")});
    });
  });
})();

(function(){
  var btn=document.getElementById("dl");
  if(!window.claude||!btn)return;
  window.claude.use("downloads").then(function(d){
    if(!d)return;
    btn.hidden=false;
    btn.addEventListener("click",function(){
      var bin=atob(PDF),n=bin.length,u=new Uint8Array(n);
      for(var i=0;i<n;i++)u[i]=bin.charCodeAt(i);
      d.save({filename:"CV Dylan Tallane.pdf",data:new Blob([u],{type:"application/pdf"})}).catch(function(){});
    });
  }).catch(function(){});
  var PDF="";
})();
</script>
</body>
</html>
